  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, endpoint_id, event_type, payload,\n               status as \"status: _\", attempts, scheduled_at, delivering_since, idempotency_key, created_at\n        FROM webhook_events\n        WHERE endpoint_id = $1 AND status = $2\n        ORDER BY created_at DESC\n        LIMIT $3 OFFSET $4\n        ",
